{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"types": ["vite/client", "frappe-types/global"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"frappe-ui/src/components/Button/Button.vue": ["../types/frappe-ui-component.d.ts"],
			"frappe-ui/src/components/FeatherIcon.vue": ["../types/frappe-ui-component.d.ts"],
			"frappe-ui/src/components/Spinner.vue": ["../types/frappe-ui-component.d.ts"],
			"frappe-ui/src/components/Badge/Badge.vue": ["../types/frappe-ui-component.d.ts"]
		}
	},
	"include": ["src/**/*.js", "src/**/*.vue", "../types/flow.augment.d.ts"]
}
