{
	"name": "flow",
	"version": "0.0.1",
	"private": true,
	"description": "AI assistant slide-in panel for the Frappe desk (frappe-ui)",
	"license": "AGPL-3.0-or-later",
	"author": "Avunu LLC",
	"type": "module",
	"scripts": {
		"dev": "vite build --watch",
		"build": "vite build && node scripts/vite-register.mjs",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"typecheck": "tsc --build tsconfig.json && node scripts/vue-tsc.cjs --noEmit -p frontend/tsconfig.json",
		"lint:py": "uv run --frozen --project tools ruff check . && uv run --frozen --project tools ruff format --check .",
		"typecheck:py": "uv run --frozen --project tools ty check --python \"${FRAPPE_BENCH_ROOT:-.frappe-nix/bench}/env\"",
		"check": "yarn -s format:check && yarn -s lint && yarn -s typecheck"
	},
	"dependencies": {
		"frappe-ui": "1.0.0-beta.3",
		"vue": "^3.5.13",
		"vue-router": "^4.4.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@vitejs/plugin-vue": "^5.2.1",
		"autoprefixer": "^10.4.20",
		"frappe-types": "^16.5.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"postcss": "^8.4.49",
		"postcss-prefix-selector": "^2.1.1",
		"tailwindcss": "^3.4.17",
		"typescript": "^7.0.2",
		"typescript5": "npm:typescript@^5.9.3",
		"vite": "^5.4.11",
		"vue-tsc": "^3.3.13"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "yarn@1.22.22",
	"frappe": {
		"major": "16",
		"branch": "version-16"
	}
}
